# Alpaca Markets (paper trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Ollama
OLLAMA_MODEL=qwen3.5:9b

# RavenDB
RAVENDB_URL=http://ravendb:8080

# ── Grocery Pack: Sainsbury's credentials ────────────────────────────────────
# ASP.NET binds double-underscore env vars to config (Section__Key).
Sainsburys__Username=you@example.com
Sainsburys__Password=your-sainsburys-password

# ── Grocery Pack: Telegram bot (long-polling) ────────────────────────────────
Telegram__BotToken=123456789:AA-your-telegram-bot-token
# Two authorised chat IDs (bound to an int array):
Telegram__AllowedChatIds__0=111111111
Telegram__AllowedChatIds__1=222222222
# Persona tone: friendly / efficient
Telegram__PersonaName=Sous
Telegram__PersonaTone=friendly, efficient, not overly talkative

